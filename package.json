{
  "name": "daily-countdown",
  "version": "1.0.0",
  "description": "One day closer to your dream. A production-ready PWA for countdown timelines with notifications, journaling, and statistics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "serve:build": "vite preview --port 5173",
    "test": "vitest",
    "lighthouse": "lighthouse https://localhost:5173 --view",
    "analyze": "vite-plugin-visualizer"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.1",
    "framer-motion": "^10.16.16",
    "@mui/material": "^5.14.13",
    "@mui/icons-material": "^5.14.13",
    "@mui/lab": "^5.0.0-alpha.61",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "recharts": "^2.10.3",
    "date-fns": "^2.30.0",
    "idb": "^8.0.0",
    "workbox-window": "^7.0.0",
    "localforage": "^1.10.0",
    "react-hot-toast": "^2.4.1",
    "react-calendar": "^4.2.1",
    "lottie-react": "^2.4.0",
    "dexie": "^4.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vite-pwa/assets-generator": "^0.2.4",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4",
    "vite-plugin-visualizer": "^9.1.0",
    "typescript": "^5.3.3",
    "tailwindcss": "^3.3.6",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
